# ================================================================
# ANIL6 ENVIRONMENT CONFIGURATION
# ================================================================

# Database URL (SQLite default or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Server Port
PORT=3000

# Public URL of the application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ----------------------------------------------------------------
# OPTION 1: GMAIL SMTP (Recommended for Real Email Delivery)
# ----------------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password" at: https://myaccount.google.com/apppasswords
# 3. Paste your email and the 16-character App Password below:
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ----------------------------------------------------------------
# OPTION 2: RESEND API (Alternative for Email Delivery)
# ----------------------------------------------------------------
# Get API key from https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ----------------------------------------------------------------
# OPTION 3: BREVO / SENDINBLUE (300 Free Emails/day)
# ----------------------------------------------------------------
# Get API key from https://brevo.com
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

# ----------------------------------------------------------------
# OPTION 4: TWILIO SMS (For Mobile Numbers)
# ----------------------------------------------------------------
# Get credentials from https://twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
